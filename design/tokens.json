{
  "$description": "Дизайн-токены «Модус Трейд»: система обращений сотрудников. Формат W3C Design Tokens (DTCG). Источники и карта применения — design/README.md.",
  "primitive": {
    "navy": {
      "900": {
        "$type": "color",
        "$value": "#082742",
        "$description": "Фирменный тёмно-синий: кольцо и надпись логотипа, заголовки сайта",
        "$extensions": {
          "kz.modus.source": "логотип: https://modus-trade.kz/upload/iblock/d2a/wav3zgzmn2frim29p8a7mt9dzux15j6w/logo-header.svg (fill #082742); на сайте — заголовки, футер"
        }
      },
      "700": {
        "$type": "color",
        "$value": "#0E3A61",
        "$description": "Наведение на тёмно-синие элементы",
        "$extensions": {
          "kz.modus.source": "производный: navy.900 светлее на 8% L"
        }
      },
      "300": {
        "$type": "color",
        "$value": "#8CB8E6",
        "$description": "Тёмно-синий для тёмной темы (первичный цвет на тёмном фоне)",
        "$extensions": {
          "kz.modus.source": "производный от navy.900 и #2F80ED сайта"
        }
      },
      "50": {
        "$type": "color",
        "$value": "#EFF6FD",
        "$description": "Светло-голубая подложка карточек проектов, новостей, фильтра",
        "$extensions": {
          "kz.modus.source": "сайт: .projectCard, .categoryCard, .filter — background #eff6fd"
        }
      }
    },
    "red": {
      "logo": {
        "$type": "color",
        "$value": "#ED1111",
        "$description": "Красный «зрачок» логотипа и фон кнопок .btn. Только для логотипа и декора: белый текст на нём 4.48:1 — ниже AA",
        "$extensions": {
          "kz.modus.source": "логотип (fill #ED1111); сайт .btn background-color"
        }
      },
      "600": {
        "$type": "color",
        "$value": "#E40000",
        "$description": "Рабочий фирменный красный: главная кнопка, акценты. Белый текст 4.89:1",
        "$extensions": {
          "kz.modus.source": "сайт: ссылки a, .header__link:hover — color #e40000 (самый частый красный в CSS)"
        }
      },
      "700": {
        "$type": "color",
        "$value": "#CC0000",
        "$description": "Наведение/нажатие на красную кнопку",
        "$extensions": {
          "kz.modus.source": "сайт: .btn:hover background #c00"
        }
      }
    },
    "ink": {
      "800": {
        "$type": "color",
        "$value": "#323A47",
        "$description": "Основной текст",
        "$extensions": {
          "kz.modus.source": "сайт: --bs-font-color, .heading-h2 #323a47"
        }
      },
      "600": {
        "$type": "color",
        "$value": "#64748D",
        "$description": "Второстепенный текст сайта (абзацы). У нас — только на белом",
        "$extensions": {
          "kz.modus.source": "сайт: .paragraph, .timeline__text #64748d"
        }
      },
      "550": {
        "$type": "color",
        "$value": "#5A6A82",
        "$description": "Второстепенный текст на любой светлой поверхности (AA на #EFF6FD)",
        "$extensions": {
          "kz.modus.source": "производный: #64748D темнее, чтобы пройти AA на navy.50"
        }
