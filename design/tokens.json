      "600": {
        "$type": "color",
        "$value": "#1A66C9",
        "$description": "Ссылки и «информация» в светлой теме (AA)",
        "$extensions": {
          "kz.modus.source": "производный: #2F80ED темнее до 5.54:1 на белом"
        }
      }
    },
    "orange": {
      "400": {
        "$type": "color",
        "$value": "#FC8D3D",
