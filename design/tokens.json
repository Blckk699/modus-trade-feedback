      "0": {
        "$type": "color",
        "$value": "#FFFFFF",
        "$description": "Поверхность карточки",
        "$extensions": {
          "kz.modus.source": "сайт: фон страниц и шапки #fff"
        }
      }
    },
    "blue": {
      "500": {
        "$type": "color",
        "$value": "#2F80ED",
        "$description": "Голубой акцент сайта (город в шапке, подзаголовки). Только для фокуса/декора: на белом 3.87:1",
        "$extensions": {
          "kz.modus.source": "сайт: .header__cityName, .heading-subtitle #2f80ed"
