      "400": {
        "$type": "color",
        "$value": "#848FA0",
        "$description": "Граница полей ввода (≥3:1 к фону, WCAG 1.4.11)",
        "$extensions": {
          "kz.modus.source": "производный от #B0B8C5 сайта"
        }
      },
      "300": {
        "$type": "color",
        "$value": "#B0B8C5",
        "$description": "Сильный разделитель",
        "$extensions": {
          "kz.modus.source": "сайт: #b0b8c5"
        }
      },
      "200": {
        "$type": "color",
        "$value": "#D1D5DD",
        "$description": "Граница карточек и разделители",
        "$extensions": {
          "kz.modus.source": "сайт: #d1d5dd"
        }
      },
      "100": {
        "$type": "color",
        "$value": "#F4F7FB",
        "$description": "Фон страницы",
        "$extensions": {
          "kz.modus.source": "производный: между #f3f3f3 футера и #eff6fd карточек"
        }
