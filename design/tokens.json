        "$description": "Montserrat — заголовки сайта (.heading-h2). Есть в Google Fonts с кириллицей"
      },
      "body": {
        "$type": "fontFamily",
        "$value": [
          "Manrope",
          "system-ui",
          "-apple-system",
          "Segoe UI",
          "Roboto",
          "sans-serif"
