# Токен продуктового бота от @BotFather. Без него бот сообщает, что не настроен, и не запускается.
TELEGRAM_BOT_TOKEN=
# Сервисный ключ бота — тот же, что BOT_SERVICE_KEY у бэкенда.
BOT_SERVICE_KEY=
# Хост API без /api/v1. Локально — мок Prism (порт 4011) или бэкенд (8000).
API_BASE_URL=http://localhost:4011
API_TIMEOUT_SECONDS=15
# HTTPS-адрес Mini App. Пусто — кнопки Mini App не показываются.
MINI_APP_URL=
