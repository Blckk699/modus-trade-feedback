# Адрес API: хост без /api/v1. Мок — http://localhost:4010.
# Локальный бэкенд (как на сервере, с настоящими ролями): VITE_API_BASE_URL=http://localhost:5173
# и VITE_API_PROXY=http://127.0.0.1:8000 — Vite перешлёт /api на бэкенд, CORS не нужен.
VITE_API_BASE_URL=http://localhost:4010
VITE_API_PROXY=

# Показывать dev-вход (выбор пользователя). На сервере для демо — false.
VITE_DEV_LOGIN=true

# Имя бота для Telegram Login (без @). Пусто — виджет не показывается.
VITE_TELEGRAM_BOT_USERNAME=

# Только для мока: какой пример /me отдавать (employee | owner). Мок не помнит, под кем был вход.
VITE_MOCK_ME_EXAMPLE=

# Только для локальной проверки экранов: вход по почте на моке в памяти вместо API. На сервере не задаётся.
VITE_EMAIL_AUTH_MOCK=

# Только для локальной проверки экранов: вход через Битрикс24 на моке, без портала. На сервере не задаётся.
VITE_BITRIX_AUTH_MOCK=

# Только для локальной проверки: переключатель ролей на dev-пользователях вместо POST /auth/switch. На сервере не задаётся.
VITE_ROLE_SWITCH_MOCK=

# Только для локальной проверки: события живых обновлений из соседних вкладок вместо сокета. На сервере не задаётся.
VITE_LIVE_MOCK=
