# Адрес API: хост без /api/v1. Мок — http://localhost:4010, локальный бэкенд — http://localhost:8000
VITE_API_BASE_URL=http://localhost:4010

# Показывать dev-вход (выбор пользователя). На сервере для демо — false.
VITE_DEV_LOGIN=true

# Имя бота для Telegram Login (без @). Пусто — виджет не показывается.
VITE_TELEGRAM_BOT_USERNAME=

# Только для мока: какой пример /me отдавать (employee | owner). Мок не помнит, под кем был вход.
VITE_MOCK_ME_EXAMPLE=
