# Образец backend/.env. Скопируйте в .env и заполните; сам .env в git не попадает.
# Здесь только пустые и демонстрационные значения: настоящие ключи сюда не пишем.

# База. В docker compose задаётся в docker-compose.yml, здесь — для локального запуска без docker.
DATABASE_URL=postgresql://modus:modus@localhost:5432/modus

# Dev-вход с выбором пользователя (B-03). На сервере для демо — false.
DEV_LOGIN_ENABLED=false
# Сервисный ключ бота, заголовок X-Service-Key. Тот же ключ задаётся боту.
BOT_SERVICE_KEY=

# Claude API
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# ElevenLabs Scribe
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v1
ELEVENLABS_LANGUAGE=rus

# Токен бота: проверка подписи Mini App и Telegram Login, служебные вызовы Bot API.
TELEGRAM_BOT_TOKEN=
# Ссылки приглашений (B-18): ник бота без @ и адрес веба.
TELEGRAM_BOT_USERNAME=modus_feedback_bot
PUBLIC_WEB_URL=http://localhost:5173

# Битрикс24: адрес входящего вебхука тестового портала и ID пользователя портала, на которого ставятся задачи.
BITRIX24_WEBHOOK_URL=
BITRIX24_RESPONSIBLE_ID=1
# Вход через Битрикс24 (B-23): код и ключ локального приложения портала и домен портала (без https://).
# Пока не заданы все три — кнопка входа скрыта. Адрес возврата приложения на портале:
# <адрес API>/api/v1/auth/bitrix/callback
BITRIX24_CLIENT_ID=
BITRIX24_CLIENT_SECRET=
BITRIX24_PORTAL=
BITRIX24_TOKEN_URL=https://oauth.bitrix24.tech/oauth/token/

# Часовой пояс системы (фиксированное смещение) и время утренней сводки.
TIMEZONE=+05:00
DIGEST_TIME=09:00
# Как часто проверять сроки и эскалацию, минут.
ESCALATION_INTERVAL_MINUTES=10

# Фоновый воркер внутри процесса API.
JOBS_WORKER_ENABLED=true
JOBS_POLL_SECONDS=5

# Файл с реальными Telegram ID демо-пользователей (вне репозитория), см. app/seed/accounts.py.
SEED_ACCOUNTS_FILE=

# Каталог вложений и предельный размер файла (байт).
ATTACHMENTS_DIR=data/attachments
ATTACHMENT_MAX_BYTES=20971520

# Кому верить в X-Forwarded-For: адрес Caddy (через запятую, можно подсети, например 172.16.0.0/12).
TRUSTED_PROXIES=127.0.0.1,::1
